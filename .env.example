# ---- Supabase (server-only; never NEXT_PUBLIC_) ----
# Create a project at supabase.com, run supabase/migrations/0001_init.sql
# in the SQL editor, then fill these in. Leave empty to run in fixture mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sessions ----
# Any long random string; sign-in cookies are HMAC-signed with it.
SESSION_SECRET=

# ---- Admin bootstrap ----
# Lets The Animals team log in at /login before/without any DB users.
ADMIN_USERNAME=animals-admin
ADMIN_PASSWORD=

# ---- Boards ----
# Board served on localhost / the bare domain (no subdomain).
DEFAULT_BOARD_SLUG=adidas
# Enable per-client subdomains: with BOARD_ROOT_DOMAIN=animalsboards.com,
# nike.animalsboards.com serves the "nike" board. Leave empty to always
# serve the default board (e.g. on *.vercel.app URLs).
BOARD_ROOT_DOMAIN=
