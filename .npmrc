# One conflict, September 2026: `npm i -D vitest` fails with ERESOLVE against
# this tree's pinned @types/node@20 — vitest 5 (via vite 8) and vitest 4 both
# want @types/node ^20.19.0 || >=22.12.0. The flag is in place for that alone.
#
# It applies to every install here and in CI, so the next genuine conflict will
# install a broken tree instead of erroring. Retire it deliberately once
# @types/node moves up: drop this file and re-run `npm install`.
legacy-peer-deps=true
